[MODBUS]
PORT = /dev/ttyUSB0
WRITE_QUEUE_SIZE = 128
WRITE_BATCH_DELAY_SEC = 0.05
TIMEOUT_SEC = 1.5
RETRIES = 2
RECONNECT_DELAY_SEC = 0.2

[LOGGING]
; INFO logs startup/shutdown, write summaries, rejections, and recovery events.
; DEBUG also logs status polling, register windows, and write details.
LEVEL = INFO

[MQTT]
HOST = localhost
PORT = 1883
USER =
PASSWORD =
CLIENT_ID = growatt_spf5000es
KEEPALIVE_SEC = 60
TOPIC_PREFIX = growatt/spf5000es
DISCOVERY_PREFIX = homeassistant
DEVICE_ID = growatt_spf5000es
DEVICE_NAME = Growatt SPF 5000 ES
RETAIN = true
CONFIG_INTERVAL_SEC = 1800
